   "operations": [
    {
     "apiStatus": {
      "description": "Stable production version",
      "value": "PRODUCTION"
     },
     "httpMethod": "GET",
     "parameters": [
      {
       "name": "X-Pagination-Cursor",
       "dataType": "string",
       "paramType": "header",
       "fullType": "string",
       "required": false,
       "description": "Pagination cursor"
      },
      {
       "name": "X-Pagination-Size",
       "dataType": "long",
       "paramType": "header",
       "fullType": "long",
       "required": false,
       "description": "Pagination size"
      },
      {
       "name": "iamTags",
       "dataType": "map[string][]iam.resource.TagFilter",
       "paramType": "query",
       "required": false,
       "description": "Filter resources on IAM tags"
      },
      {
       "name": "resourceName",
       "dataType": "uuid",
       "paramType": "path",
       "fullType": "uuid",
       "required": true,
       "description": "Resource name"
      }
     ],
     "responseType": "networkDefense.Vac.PolicyAsyncResourceWithIAM[]",
     "responseTypes": {
      "200": "networkDefense.Vac.PolicyAsyncResource[]"
     },
     "noAuthentication": false,
     "description": "List VAC policies",
     "longDescription": "Returns the list of policies within a VAC DDoS protection resource. Every policy applies a profile and a sensitivity level to target IP address prefixes, and carries the configuration requested and the one currently enforced.",
     "iamActions": [
      {
       "name": "vac:apiovh:resource/policy/get",
       "required": true
      }
     ]
    },
    {
     "apiStatus": {
      "description": "Stable production version",
      "value": "PRODUCTION"
     },
     "httpMethod": "POST",
     "parameters": [
      {
       "dataType": "networkDefense.Vac.PolicyAsyncAdd",
       "paramType": "body",
       "fullType": "networkDefense.Vac.PolicyAsyncAdd",
       "required": true,
       "description": "Request Body"
      },
      {
       "name": "force",
       "dataType": "boolean",
       "paramType": "query",
       "fullType": "boolean",
       "required": false,
       "description": "Overwrite the protection settings that were not set via a policy on the targets this request adds. Without it, such a request is refused. The previous settings are lost: you cannot restore them yourself. The 'force' flag is not stored in the policy spec."
      },
      {
       "name": "resourceName",
       "dataType": "uuid",
       "paramType": "path",
       "fullType": "uuid",
       "required": true,
       "description": "Resource name"
      }
     ],
     "responseType": "networkDefense.Vac.PolicyAsyncResource",
     "responseTypes": {
      "200": "networkDefense.Vac.PolicyAsyncResource"
     },
     "noAuthentication": false,
     "description": "Create a VAC policy",
     "longDescription": "Creates a policy within a VAC DDoS protection resource, applying a profile and a sensitivity level to target IP address prefixes in order to tune detection and mitigation rules. Async call, follow resourceStatus for operation progress. A target whose prefix carries protection settings that were not set via a policy is refused, unless you send force=true to overwrite them.",
     "errors": [
      "Client::BadRequest::DuplicateTarget",
      "Client::BadRequest::InvalidPrefix",
      "Client::BadRequest::ProfileDoesNotExist",
      "Client::BadRequest::ProfileNotAssignable",
      "Client::BadRequest::ProfileRetired",
      "Client::BadRequest::RequiredField",
      "Client::BadRequest::SensitivityNotDefined",
      "Client::BadRequest::TooManyTargets",
      "Client::Forbidden::DestinationNotAllowed",
      "Client::NotFound::ServiceDoesNotExist",
      "Client::Conflict::PolicyNameAlreadyExists",
      "Client::Conflict::PrefixAlreadyAssigned",
      "Client::Conflict::QuotaExceeded",
      "Client::Conflict::ResourceBusy",
      "Client::Conflict::UnmanagedConfiguration"
     ],
     "iamActions": [
      {
       "name": "vac:apiovh:resource/policy/create",
       "required": true
      },
      {
       "name": "ip:apiovh:networkDefense/vac/protect",
       "required": true
      }
     ]
    }
   ],
   "description": "Manage policies. Each policy links a network traffic profile, sensitivity level and state with target IP address prefixes in order to tune detection and mitigation behavior."
  },
