      "Client::NotFound::PolicyDoesNotExist"
     ],
     "iamActions": [
      {
       "name": "vac:apiovh:resource/policy/get",
       "required": true
      }
     ]
    },
    {
     "apiStatus": {
      "description": "Stable production version",
      "value": "PRODUCTION"
     },
     "httpMethod": "PUT",
     "parameters": [
      {
       "dataType": "networkDefense.Vac.PolicyAsyncUpdate",
       "paramType": "body",
       "fullType": "networkDefense.Vac.PolicyAsyncUpdate",
       "required": true,
       "description": "Request Body"
      },
      {
       "name": "force",
       "dataType": "boolean",
       "paramType": "query",
       "fullType": "boolean",
       "required": false,
       "description": "Overwrite the protection settings that were not set via a policy on the targets this request adds. Without it, such a request is refused. The previous settings are lost: you cannot restore them yourself. The 'force' flag is not stored in the policy spec."
      },
      {
       "name": "policyId",
       "dataType": "uuid",
       "paramType": "path",
       "fullType": "uuid",
       "required": true,
       "description": "Policy ID"
      },
      {
       "name": "resourceName",
       "dataType": "uuid",
       "paramType": "path",
       "fullType": "uuid",
       "required": true,
       "description": "Resource name"
      }
     ],
     "responseType": "networkDefense.Vac.PolicyAsyncResource",
     "responseTypes": {
      "200": "networkDefense.Vac.PolicyAsyncResource"
     },
     "noAuthentication": false,
     "description": "Update a VAC policy",
     "longDescription": "Updates the name, enabled state, targets, profile and sensitivity level of a policy. The targets sent fully replace the previous ones: an omitted or empty list of targets removes every target from the policy. Removed target IPs reset their VAC DDoS protection settings to the default state. Send the checksum from the last read; a stale value is rejected. A new target whose prefix carries protection settings that were not set via a policy is refused, unless you send force=true to overwrite them.",
     "errors": [
      "Client::BadRequest::DuplicateTarget",
      "Client::BadRequest::InvalidPrefix",
      "Client::BadRequest::ProfileDoesNotExist",
      "Client::BadRequest::ProfileNotAssignable",
      "Client::BadRequest::ProfileRetired",
      "Client::BadRequest::RequiredField",
      "Client::BadRequest::SensitivityNotDefined",
      "Client::BadRequest::TooManyTargets",
      "Client::Forbidden::DestinationNotAllowed",
      "Client::NotFound::PolicyDoesNotExist",
      "Client::Conflict::PolicyNameAlreadyExists",
      "Client::Conflict::PrefixAlreadyAssigned",
      "Client::Conflict::ResourceBusy",
      "Client::Conflict::TargetAlreadyDeclared",
      "Client::Conflict::UnmanagedConfiguration",
      "Client::PreconditionFailed::InvalidChecksum"
     ],
     "iamActions": [
      {
       "name": "vac:apiovh:resource/policy/edit",
       "required": true
      },
      {
       "name": "ip:apiovh:networkDefense/vac/protect",
       "required": true
      }
     ]
    }
   ],
